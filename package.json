    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/core": "^14.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-format": "^1.3.1",
    "lint-staged": "^16.2.7",
